{
  "uid": "board-hosts",
  "title": "6. 호스트 (CPU·메모리·디스크·네트워크)",
  "description": "병목이 앱 노드 CPU인지, 데이터 노드 디스크인지, 부하 노드 자체인지 가른다. node-exporter가 있는 AWS 구성에서만 값이 나온다.",
  "tags": [
    "board"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "노드",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info, node)",
          "refId": "node"
        },
        "definition": "label_values(node_uname_info, node)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "CPU",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU 사용률",
      "description": "idle을 뺀 모든 모드의 비율. 앱 노드가 1에 붙으면 서비스가 CPU에서 막힌 것이다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - avg by (node) (rate(node_cpu_seconds_total{node=~\"$node\", mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU iowait·steal 비율",
      "description": "iowait는 디스크를 기다린 시간, steal은 하이퍼바이저에 빼앗긴 시간. 데이터 노드 iowait가 오르면 디스크 병목이다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (node) (rate(node_cpu_seconds_total{node=~\"$node\", mode=\"iowait\"}[$__rate_interval]))",
          "legendFormat": "{{node}} iowait",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (node) (rate(node_cpu_seconds_total{node=~\"$node\", mode=\"steal\"}[$__rate_interval]))",
          "legendFormat": "{{node}} steal",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "코어당 load(1분)",
      "description": "1분 load average를 코어 수로 나눈 값. 1을 넘으면 실행 대기 중인 작업이 코어보다 많다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_load1{node=~\"$node\"} / on (node) count by (node) (node_cpu_seconds_total{node=~\"$node\", mode=\"idle\"})",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "메모리·디스크",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "가용 메모리 비율",
      "description": "MemAvailable / MemTotal. 낮아지면 페이지 캐시가 줄고 OOM 위험이 커진다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_MemAvailable_bytes{node=~\"$node\"} / node_memory_MemTotal_bytes{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "디스크 IO 사용률",
      "description": "장치가 요청을 처리하느라 바빴던 시간 비율. 1에 가까우면 디스크가 포화됐다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_disk_io_time_seconds_total{node=~\"$node\", device!~\"loop.*|ram.*\"}[$__rate_interval])",
          "legendFormat": "{{node}} {{device}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "디스크 요청당 대기 시간",
      "description": "읽기·쓰기 한 건이 끝날 때까지 걸린 평균 시간 (대기 + 처리)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(rate(node_disk_read_time_seconds_total{node=~\"$node\", device!~\"loop.*|ram.*\"}[$__rate_interval]) + rate(node_disk_write_time_seconds_total{node=~\"$node\", device!~\"loop.*|ram.*\"}[$__rate_interval])) / clamp_min(rate(node_disk_reads_completed_total{node=~\"$node\", device!~\"loop.*|ram.*\"}[$__rate_interval]) + rate(node_disk_writes_completed_total{node=~\"$node\", device!~\"loop.*|ram.*\"}[$__rate_interval]), 1e-9)",
          "legendFormat": "{{node}} {{device}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "파일 시스템 사용률",
      "description": "루트 파일 시스템에서 쓰인 비율",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - node_filesystem_avail_bytes{node=~\"$node\", mountpoint=\"/\"} / node_filesystem_size_bytes{node=~\"$node\", mountpoint=\"/\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "디스크 처리량",
      "description": "초당 읽고 쓴 바이트",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (rate(node_disk_read_bytes_total{node=~\"$node\", device!~\"loop.*|ram.*\"}[$__rate_interval]))",
          "legendFormat": "{{node}} 읽기",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (rate(node_disk_written_bytes_total{node=~\"$node\", device!~\"loop.*|ram.*\"}[$__rate_interval]))",
          "legendFormat": "{{node}} 쓰기",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "네트워크",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "네트워크 송수신",
      "description": "물리 인터페이스의 초당 바이트. 부하 노드 송신이 인스턴스 대역폭에 닿으면 부하 생성기가 병목이다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (rate(node_network_receive_bytes_total{node=~\"$node\", device!~\"lo|veth.*|cni.*|flannel.*|docker.*|br-.*\"}[$__rate_interval]))",
          "legendFormat": "{{node}} 수신",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (rate(node_network_transmit_bytes_total{node=~\"$node\", device!~\"lo|veth.*|cni.*|flannel.*|docker.*|br-.*\"}[$__rate_interval]))",
          "legendFormat": "{{node}} 송신",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "TCP 재전송·연결 수",
      "description": "재전송이 늘면 네트워크나 상대가 밀리는 것이다. 연결 수는 커넥션 풀·keep-alive 확인용",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_netstat_Tcp_RetransSegs{node=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{node}} 재전송/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_netstat_Tcp_CurrEstab{node=~\"$node\"}",
          "legendFormat": "{{node}} 연결",
          "refId": "B"
        }
      ]
    }
  ],
  "editable": true
}
